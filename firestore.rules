rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ──────────────────────────────────────────────────────────
    // 1. Private User Profiles: /users/{userId}
    // Strictly restricted to document owner only.
    // Zero cross-user updates permitted under any circumstance.
    // ──────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isUser(userId);

      allow create: if isUser(userId) &&
        request.resource.data.id == userId &&
        (!('email' in request.auth.token) || request.resource.data.email == request.auth.token.email) &&
        request.resource.data.currentCircleId == null;

      allow update: if isUser(userId) &&
        // Immutability of core identity fields
        request.resource.data.id == resource.data.id &&
        (!('email' in resource.data) || !('email' in request.resource.data) || request.resource.data.email == resource.data.email) &&
        (!('createdAt' in resource.data) || !('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
        // Only explicitly approved fields can be modified
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'role', 'emergencyPhone', 'avatarInitial', 'isProfileSetupComplete', 'currentCircleId'
        ]) &&
        // Validate currentCircleId change: can only be null (leaving) OR must already be confirmed in circle memberIds
        (
          request.resource.data.currentCircleId == null ||
          (
            exists(/databases/$(database)/documents/circles/$(request.resource.data.currentCircleId)) &&
            request.auth.uid in get(/databases/$(database)/documents/circles/$(request.resource.data.currentCircleId)).data.memberIds
          )
        );

      allow delete: if isUser(userId);
    }

    // ──────────────────────────────────────────────────────────
    // 2. Family Circles: /circles/{circleId}
    // ──────────────────────────────────────────────────────────
    match /circles/{circleId} {
      // Read allowed ONLY if authenticated and verified member of the circle or owner
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.memberIds != null && request.auth.uid in resource.data.memberIds)
      );

      // Create: user must set themselves as owner and be included in memberIds
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.auth.uid in request.resource.data.memberIds;

      // Update:
      // A) Circle Owner: can update metadata (name, description, inviteCode, inviteExpiresAt)
      //    Owner CANNOT change ownerId.
      // B) Non-owner joining: requires active, unexpired invite belonging strictly to THIS circle.
      // C) Non-owner leaving: can only remove their own UID.
      allow update: if isAuthenticated() && (
        // Case A: Owner update
        (
          resource.data.ownerId == request.auth.uid &&
          request.resource.data.ownerId == resource.data.ownerId
        ) ||
        // Case B & C: Non-owner memberIds update only
        (
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) && (
            // Joining: adding exclusively own UID AND requiring active, unexpired invite belonging to this circle
            (
              request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()) == [request.auth.uid].toSet() &&
              resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet()).size() == 0 &&
              ('inviteCode' in resource.data) &&
              exists(/databases/$(database)/documents/invites/$(resource.data.inviteCode)) &&
              get(/databases/$(database)/documents/invites/$(resource.data.inviteCode)).data.circleId == circleId &&
              get(/databases/$(database)/documents/invites/$(resource.data.inviteCode)).data.isActive == true &&
              get(/databases/$(database)/documents/invites/$(resource.data.inviteCode)).data.expiresAt > request.time.toMillis()
            ) ||
            // Leaving: removing exclusively own UID
            (
              resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet()) == [request.auth.uid].toSet() &&
              request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()).size() == 0
            )
          )
        )
      );

      // Delete allowed only by circle owner
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      // ──────────────────────────────────────────────────────────
      // 3. Member Display Documents: /circles/{circleId}/members/{memberId}
      // Zero PII (no email, no phone). Contains only display metadata.
      // ──────────────────────────────────────────────────────────
      match /members/{memberId} {
        // Read restricted to circle members and owner
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/circles/$(circleId)).data.ownerId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.memberIds
        );

        // Create:
        // Member creating own card upon joining (must have valid active invite belonging to this circle)
        // OR owner creating initial card
        allow create: if isAuthenticated() && (
          (
            request.auth.uid == memberId &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.id == request.auth.uid &&
            request.resource.data.role == "Member" &&
            request.resource.data.isSharingActive == false &&
            ('inviteCode' in get(/databases/$(database)/documents/circles/$(circleId)).data) &&
            exists(/databases/$(database)/documents/invites/$(get(/databases/$(database)/documents/circles/$(circleId)).data.inviteCode)) &&
            get(/databases/$(database)/documents/invites/$(get(/databases/$(database)/documents/circles/$(circleId)).data.inviteCode)).data.circleId == circleId &&
            get(/databases/$(database)/documents/invites/$(get(/databases/$(database)/documents/circles/$(circleId)).data.inviteCode)).data.isActive == true &&
            get(/databases/$(database)/documents/invites/$(get(/databases/$(database)/documents/circles/$(circleId)).data.inviteCode)).data.expiresAt > request.time.toMillis()
          ) ||
          (
            get(/databases/$(database)/documents/circles/$(circleId)).data.ownerId == request.auth.uid &&
            request.resource.data.userId == memberId &&
            request.resource.data.id == memberId
          )
        );

        // Update:
        // Members may update ONLY their own card and ONLY approved fields (name, avatarInitial, statusText, isSharingActive, batteryPercent, lastSeenText)
        // Members CANNOT change protected fields: userId, id, role, joinedAt!
        // Circle owner can update member role or remove
        allow update: if isAuthenticated() && (
          // Regular member updating their own card
          (
            request.auth.uid == memberId &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.id == resource.data.id &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.joinedAt == resource.data.joinedAt &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'avatarInitial', 'avatarColorHex', 'isSharingActive', 'statusText', 'batteryPercent', 'lastSeenText'
            ])
          ) ||
          // Circle owner modifying card (e.g. assigning role)
          (
            get(/databases/$(database)/documents/circles/$(circleId)).data.ownerId == request.auth.uid &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.id == resource.data.id
          )
        );

        // Delete: allowed by the member themselves (leaving) OR by circle owner (removing)
        allow delete: if isAuthenticated() && (
          request.auth.uid == memberId ||
          get(/databases/$(database)/documents/circles/$(circleId)).data.ownerId == request.auth.uid
        );
      }
    }

    // ──────────────────────────────────────────────────────────
    // 4. Invite Codes: /invites/{code}
    // ──────────────────────────────────────────────────────────
    match /invites/{code} {
      // Readable ONLY if active and not expired (enforced with server request.time)
      allow read: if isAuthenticated() &&
        resource.data.isActive == true &&
        resource.data.expiresAt > request.time.toMillis();

      // Only the verified circle owner can create invite codes with maximum 48h validity
      allow create: if isAuthenticated() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.circleId != null &&
        exists(/databases/$(database)/documents/circles/$(request.resource.data.circleId)) &&
        get(/databases/$(database)/documents/circles/$(request.resource.data.circleId)).data.ownerId == request.auth.uid &&
        request.resource.data.expiresAt <= request.time.toMillis() + (48 * 60 * 60 * 1000);

      // Deactivation / update / delete strictly restricted to verified circle owner
      allow update, delete: if isAuthenticated() &&
        exists(/databases/$(database)/documents/circles/$(resource.data.circleId)) &&
        get(/databases/$(database)/documents/circles/$(resource.data.circleId)).data.ownerId == request.auth.uid;
    }
  }
}
