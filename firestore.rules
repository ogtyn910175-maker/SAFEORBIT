rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Private User profiles: users/{userId}
    // Strictly restricted to owner only (protects email, emergencyPhone, and PII)
    match /users/{userId} {
      allow read: if isUser(userId);
      allow create: if isUser(userId);
      allow update: if isUser(userId) || (
        // Only circle owner removing a member can update currentCircleId
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentCircleId'])
      );
      allow delete: if isUser(userId);
    }

    // 2. Family circles: circles/{circleId}
    match /circles/{circleId} {
      // Read allowed ONLY if authenticated and verified member of the circle or owner
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.memberIds != null && request.auth.uid in resource.data.memberIds)
      );

      // Create allowed if authenticated and sets self as owner
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.auth.uid in request.resource.data.memberIds;

      // Update allowed by owner, or strictly controlled joining/leaving
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) && (
            // Joining: adding exclusively own UID AND requiring active, unexpired invite code
            (
              request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()) == [request.auth.uid].toSet() &&
              resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet()).size() == 0 &&
              exists(/databases/$(database)/documents/invites/$(resource.data.inviteCode)) &&
              get(/databases/$(database)/documents/invites/$(resource.data.inviteCode)).data.isActive == true &&
              get(/databases/$(database)/documents/invites/$(resource.data.inviteCode)).data.expiresAt > request.time.toMillis()
            ) ||
            // Leaving: removing exclusively own UID
            (
              resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet()) == [request.auth.uid].toSet() &&
              request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()).size() == 0
            )
          )
        )
      );

      // Delete allowed only by circle owner
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      // 3. Separate, limited member display documents: circles/{circleId}/members/{memberId}
      // Contains ONLY public/circle display fields (name, role, avatarInitial, statusText).
      // ZERO PII (no email, no emergency phone).
      match /members/{memberId} {
        // Only verified circle members or the circle owner can read member cards
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/circles/$(circleId)).data.ownerId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.memberIds
        );

        // Member can write their own card if already in memberIds or joining with valid active invite:
        allow write: if isAuthenticated() && (
          (request.auth.uid == memberId && (
            request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.memberIds ||
            (
              exists(/databases/$(database)/documents/invites/$(get(/databases/$(database)/documents/circles/$(circleId)).data.inviteCode)) &&
              get(/databases/$(database)/documents/invites/$(get(/databases/$(database)/documents/circles/$(circleId)).data.inviteCode)).data.isActive == true &&
              get(/databases/$(database)/documents/invites/$(get(/databases/$(database)/documents/circles/$(circleId)).data.inviteCode)).data.expiresAt > request.time.toMillis()
            )
          )) ||
          get(/databases/$(database)/documents/circles/$(circleId)).data.ownerId == request.auth.uid
        );
      }
    }

    // 4. Invite codes: invites/{code}
    match /invites/{code} {
      // Invite is readable only if active and not expired (enforced with server request.time)
      allow read: if isAuthenticated() &&
        resource.data.isActive == true &&
        resource.data.expiresAt > request.time.toMillis();

      // Only circle members/creators can create invite codes with maximum 48h validity
      allow create: if isAuthenticated() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.expiresAt <= request.time.toMillis() + (48 * 60 * 60 * 1000);

      // Invite creator or circle owner can update or delete
      allow update, delete: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        get(/databases/$(database)/documents/circles/$(resource.data.circleId)).data.ownerId == request.auth.uid
      );
    }
  }
}
